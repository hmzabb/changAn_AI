                <mxCell id="redis_box" value="&lt;b&gt;Redis 核心&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;arcSize=10;dashed=1;dashPattern=8 8;" parent="1" vertex="1">
