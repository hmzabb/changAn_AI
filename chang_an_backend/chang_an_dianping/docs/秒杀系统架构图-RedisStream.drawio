                </mxCell>
                <mxCell id="lua_script" value="&lt;b&gt;seckill.lua 原子脚本&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;① GET stockKey 判断库存&lt;br&gt;② SISMEMBER 判断重复下单&lt;br&gt;③ INCRBY -1 扣库存&lt;br&gt;④ SADD 记录用户已下单&lt;br&gt;⑤ XADD 发送订单消息到 Stream&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;返回 0=成功 | 1=库存不足 | 2=重复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="455" y="100" width="330" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="redis_stock" value="&lt;b&gt;库存 Key&lt;/b&gt;&lt;br&gt;seckill:stock:{voucherId}&lt;br&gt;String(INT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=10;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="455" y="240" width="155" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="redis_order_set" value="&lt;b&gt;已下单用户 Set&lt;/b&gt;&lt;br&gt;seckill:order:{voucherId}&lt;br&gt;Set&lt;userId&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=10;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="630" y="240" width="155" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="redis_stream" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent;&quot;&gt;Redis Stream 消息队列&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;stream.orders&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;━━━━━━━━━━━━━&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;消费者组: g1&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;消费者: c1&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;━━━━━━━━━━━━━&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• XREADGROUP 读取消息&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• XACK 确认消费&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;• Pending List 重试机制&lt;/span&gt;&lt;/div&gt;" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#0066cc;fontSize=10;align=center;spacingLeft=10;" parent="1" vertex="1">
