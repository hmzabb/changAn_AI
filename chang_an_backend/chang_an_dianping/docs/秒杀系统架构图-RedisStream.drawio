                <mxCell id="flow_desc" value="&lt;b&gt;核心流程说明&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 用户发起秒杀请求 → Controller 路由 → Service&lt;br&gt;② 时间校验 → 生成分布式订单ID → 初始化Redis库存&lt;br&gt;③ 执行 &lt;font color=&quot;#d6b656&quot;&gt;seckill.lua&lt;/font&gt; 原子操作（判断库存、防重复、扣库存、发消息）&lt;br&gt;④ Lua 脚本通过 &lt;font color=&quot;#0066cc&quot;&gt;XADD&lt;/font&gt; 将订单消息写入 Redis Stream&lt;br&gt;⑤ &lt;font color=&quot;#4caf50&quot;&gt;立即返回&lt;/font&gt; orderId 给用户（异步下单）&lt;br&gt;⑥ &lt;font color=&quot;#cc0000&quot;&gt;VoucherOrderHandler&lt;/font&gt; 后台线程从 Stream 消费消息&lt;br&gt;⑦ 获取 &lt;font color=&quot;#e91e63&quot;&gt;Redisson 分布式锁&lt;/font&gt; → 数据库事务写入&lt;br&gt;⑧ &lt;font color=&quot;#0066cc&quot;&gt;XACK&lt;/font&gt; 确认消费；异常进入 &lt;font color=&quot;#f44336&quot;&gt;Pending List&lt;/font&gt; 重试&lt;br&gt;⑨ 数据库层 &lt;font color=&quot;#d79b00&quot;&gt;乐观锁 gt(&quot;stock&quot;, 0)&lt;/font&gt; 作为最后一道防线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=10;arcSize=5;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="740" width="500" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="defense_title" value="&lt;b&gt;四道防线（纵深防御）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#c62828;" parent="1" vertex="1">
                    <mxGeometry x="600" y="640" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="defense1" value="&lt;b&gt;第一道&lt;/b&gt;：Lua 原子操作&lt;br&gt;防超卖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e57373;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="680" width="130" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="defense2" value="&lt;b&gt;第二道&lt;/b&gt;：Redisson 锁&lt;br&gt;防重复下单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e57373;fontSize=10;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="740" y="680" width="130" height="45" as="geometry"/>
