                </mxCell>
                <mxCell id="consumer_step6" value="⑥ 失败 → 抛异常触发 RocketMQ 重试&lt;br&gt;   默认重试 16 次，每次间隔递增&lt;br&gt;   最终失败 → 进入死信队列 DLQ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontSize=10;arcSize=5;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="915" y="425" width="290" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="consumer_note" value="&lt;b&gt;RocketMQ 消费者优势&lt;/b&gt;&lt;br&gt;• 内置重试机制（无需手动 Pending List）&lt;br&gt;• 支持并发消费 (CONCURRENTLY)&lt;br&gt;• 消息持久化，服务重启不丢消息&lt;br&gt;• 死信队列兜底，异常消息不丢失" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=10;arcSize=5;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="915" y="490" width="290" height="55" as="geometry"/>
                </mxCell>
