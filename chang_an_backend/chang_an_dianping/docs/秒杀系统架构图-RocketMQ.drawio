                <mxCell id="lua_script" value="&lt;b&gt;seckill.lua 原子脚本&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;① GET stockKey 判断库存&lt;br&gt;② SISMEMBER 判断重复下单&lt;br&gt;③ INCRBY -1 扣库存&lt;br&gt;④ SADD 记录用户已下单&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;返回 0=成功 | 1=库存不足 | 2=重复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;arcSize=10;" parent="1" vertex="1">
