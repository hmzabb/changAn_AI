                    <mxGeometry x="480" y="770" width="80" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="legend_fallback" value="补偿机制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#e57373;fontSize=10;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="570" y="770" width="80" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="flow_desc" value="&lt;b&gt;RocketMQ 方案核心流程&lt;/b&gt;&lt;br&gt;&lt;br&gt; 用户发起秒杀请求 → Controller 路由 → Service&lt;br&gt;② 时间校验 → 生成分布式订单ID → 初始化Redis库存&lt;br&gt;③ 执行 &lt;font color=&quot;#d6b656&quot;&gt;seckill.lua&lt;/font&gt; 原子操作（判断库存、防重复、扣库存）&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;：RocketMQ 方案 Lua 脚本中 &lt;font color=&quot;#b85450&quot;&gt;不包含 XADD&lt;/font&gt;，消息发送回 Java 侧处理&lt;br&gt;④ &lt;font color=&quot;#4a86e8&quot;&gt;syncSend&lt;/font&gt; 同步发送消息到 RocketMQ Topic&lt;br&gt;⑤ &lt;font color=&quot;#4caf50&quot;&gt;立即返回&lt;/font&gt; orderId 给用户（异步下单）&lt;br&gt;⑥ &lt;font color=&quot;#cc0000&quot;&gt;SeckillOrderConsumer&lt;/font&gt; 监听 Topic 消费消息&lt;br&gt;⑦ 获取 &lt;font color=&quot;#e91e63&quot;&gt;Redisson 分布式锁&lt;/font&gt; → 数据库事务写入&lt;br&gt;⑧ 消费失败 → RocketMQ 自动重试（默认16次）→ 死信队列 DLQ&lt;br&gt;⑨ &lt;font color=&quot;#e57373&quot;&gt;发送失败&lt;/font&gt; → 本地消息表补偿（tb_seckill_message）定时重试" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=10;arcSize=5;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="820" width="500" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="compare_box" value="&lt;b&gt;Redis Stream vs RocketMQ 对比&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#0d0d1a;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=10;" parent="1" vertex="1">
