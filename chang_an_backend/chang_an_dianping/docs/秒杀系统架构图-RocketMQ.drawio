                    <mxGeometry x="915" y="290" width="290" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="consumer_step4" value="④ 数据库事务：扣库存 + 创建订单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontSize=10;arcSize=5;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="915" y="335" width="290" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="consumer_step5" value=" 成功 → 返回 SUCCESS（ACK确认）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=10;arcSize=5;align=left;spacingLeft=8;" parent="1" vertex="1">
