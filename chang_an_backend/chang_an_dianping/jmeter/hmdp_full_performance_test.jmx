      <!-- ==================== 场景5: 秒杀系统压力测试（基于你的真实优惠券数据） ==================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="05_秒杀系统测试_50元代金券_库存100_(5000线程)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">5000</stringProp>
        <stringProp name="ThreadGroup.ramp_time">3</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.comments">
🎯 主测对象：50元代金券（voucher_id=1）
📦 初始库存：100张（来自你的真实数据库 tb_seckill_voucher）
🏪 所属商铺：商铺ID=1
⏰ 有效期：2026-08-01 至 2027-10-03 23:59:59（当前有效）

📊 场景说明：模拟5000用户同时抢购100张50元代金券
🛡️ 技术架构：
   ├─ Redis Lua脚本（seckill.lua）：原子性库存判断+扣减+下单
   ├─ Redis Stream消息队列：异步解耦，削峰填谷
   └─ 异步消费者（VoucherOrderHandler）：创建数据库订单

📈 预期指标：
   - QPS ≥ 15,000（Lua脚本执行<1ms，极快）
   - P99 < 100ms（大部分用户在Redis层就被处理完毕）
   - 最终订单数 = 100（等于初始库存，零超卖）
   - 成功抢购用户数 = 100（前100个获得锁的用户）
   - 库存不足用户数 = 4900（其余用户看到"库存不足"提示）

🔧 测试前准备（必须完成！）：
   1. 确认Redis中库存已初始化：
      redis-cli GET seckill:stock:1  # 应该返回 "100"
      如果不是，执行：redis-cli SET seckill:stock:1 100

   2. 清空历史订单数据（避免干扰）：
      redis-cli DEL seckill:order:1
      redis-cli DEL stream.orders
      -- 在MySQL中执行：DELETE FROM tb_voucher_order WHERE voucher_id=1;

   3. （可选）如果库存已被消耗，重置数据库：
      UPDATE tb_seckill_voucher SET stock = 100 WHERE voucher_id = 1;

💡 测试后验证（非常重要！）：
   1. 检查Redis最终库存：
      redis-cli GET seckill:stock:1  # 应该为 "0"

   2. 检查订单表总订单数：
      SELECT COUNT(*) FROM tb_voucher_order WHERE voucher_id=1;
      # 应该 = 100（绝对不能超过100！）

   3. 检查是否有重复下单：
      SELECT user_id, COUNT(*) as cnt FROM tb_voucher_order 
      WHERE voucher_id=1 GROUP BY user_id HAVING cnt > 1;
      # 应该返回空集（每用户限购1张）

   4. 检查Stream消息是否消费完毕：
      redis-cli XLEN stream.orders  # 应该为 0（所有消息已消费）
        </stringProp>
      </ThreadGroup>
      <hashTree>

        <!-- 使用全局变量 MAIN_VOUCHER_ID=1（50元代金券） -->
        <UserParameters guiclass="UserParametersGui" testclass="UserParameters" testname="秒杀商品ID=${MAIN_VOUCHER_ID}_50元代金券" enabled="true">
          <collectionProp name="UserParameters.names">
            <stringProp name="-1312849865">voucherId</stringProp>
          </collectionProp>
          <collectionProp name="UserParameters.thread_values">
            <collectionProp name="-1643566876">
              <stringProp name="1652392738">${MAIN_VOUCHER_ID}</stringProp>
            </collectionProp>
          </collectionProp>
          <boolProp name="UserParameters.per_iteration">false</boolProp>
          <stringProp name="UserParameters.comments">使用全局变量MAIN_VOUCHER_ID，默认值为1（50元代金券，库存100）</stringProp>
        </UserParameters>
        <hashTree/>

        <!-- 同步定时器：模拟秒杀瞬间并发（5000人在3秒内同时点击"立即抢购"按钮） -->
        <SyncTimer guiclass="SyncTimerGui" testclass="SyncTimer" testname="同步定时器_模拟5000人同时抢购" enabled="true">
          <stringProp name="Timer.groupSize">0</stringProp>
          <stringProp name="Timer.timeoutInMs">3000</stringProp>
          <stringProp name="Timer.comments">timeoutInMs=3000表示最多等3秒，超时后不再等待就直接发送</stringProp>
        </SyncTimer>
        <hashTree/>

        <!-- HTTP请求：秒杀下单接口 -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST_秒杀下单_50元代金券" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/voucher-order/seckill/${voucherId}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp>
          <boolProp name="HTTPSampler.image_parser">true</boolProp>
          <stringProp name="HTTPSampler.embedded_url_replacements"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- HTTP Header：携带认证信息（用于识别用户身份，防止重复下单） -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="认证头_用户身份标识" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${TEST_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- 响应断言1：HTTP状态码200 -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言_HTTP状态码200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">❌ 秒杀接口返回非200状态码，可能是服务器内部错误</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- 响应断言2：验证业务逻辑（三种结果都是正常的） -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言_业务逻辑正确_成功/库存不足/重复下单" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">(orderId|&quot;msg&quot;:&quot;库存不足&quot;|&quot;msg&quot;:&quot;不能重复下单&quot;)</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">❌ 秒杀业务逻辑异常，返回了非预期的结果格式</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.comments">
              可能的三种返回结果：
              1. {"orderId": 12345, ...} - 抢购成功，返回订单ID
              2. {"msg": "库存不足"} - 抢购失败，库存已耗尽
              3. {"msg": "不能重复下单"} - 该用户已经抢过一张了
            </stringProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- 响应时间断言：Lua脚本执行应该非常快（<100ms，纯内存操作） -->
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="断言_Lua脚本执行&lt;100ms_应该是毫秒级" enabled="true">
            <stringProp name="DurationAssertion.duration">100</stringProp>
            <stringProp name="DurationAssertion.custom_message">⚠️ Lua脚本执行过慢(&gt;100ms)，可能存在性能问题或Redis阻塞</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

