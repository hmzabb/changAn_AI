      <!-- ==================== 场景1: 缓存命中测试（基准测试） ==================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="01_缓存命中测试_基准性能(1000线程)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">100</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1000</stringProp>
        <stringProp name="ThreadGroup.ramp_time">10</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.comments">
📊 场景说明：验证缓存命中时的系统性能
🎯 测试目标：商铺ID 1-15（数据库中真实存在的15家商铺）
📈 预期指标：
   - QPS ≥ 20,000（缓存命中应该非常快）
   - P99 < 20ms（Redis读取通常<1ms）
   - 成功率 100%
   - 数据库QPS ≈ 0（所有请求应该命中缓存）
💡 用途：作为其他场景的对比基准线
        </stringProp>
      </ThreadGroup>
      <hashTree>

        <!-- 思考时间：模拟真实用户浏览间隔（高斯分布更真实） -->
        <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer" testname="用户思考时间(高斯分布)" enabled="true">
          <stringProp name="ConstantTimer.delay">100</stringProp>
          <stringProp name="RandomTimer.range">50</stringProp>
