              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- 响应断言：验证请求成功（即使返回旧数据也算成功，这是逻辑过期方案的特性） -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言_击穿防护有效_允许返回旧数据" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="2078830833">&quot;success&quot;:true</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">❌ 击穿防护失效！可能有大量请求打到数据库导致超时，检查分布式锁是否正常工作</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">16</intProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- 响应时间断言：击穿时应该快速返回（<200ms，即使是旧数据也比等锁快） -->
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="断言_响应时间&lt;200ms_逻辑过期方案应快速返回" enabled="true">
            <stringProp name="DurationAssertion.duration">200</stringProp>
            <stringProp name="DurationAssertion.custom_message">⚠️ 击穿时响应过慢(&gt;200ms)，可能未使用逻辑过期方案，或者锁等待时间过长</stringProp>
          </DurationAssertion>
          <hashTree/>
