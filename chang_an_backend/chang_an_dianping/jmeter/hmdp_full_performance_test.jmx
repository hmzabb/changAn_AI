          <boolProp name="HTTPSampler.BROWSER_COMPATIBLE_MULTIPART">false</boolProp>
          <boolProp name="HTTPSampler.image_parser">true</boolProp>
          <stringProp name="HTTPSampler.embedded_url_replacements"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">3000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">3000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>

          <!-- HTTP Header -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="认证头" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${TEST_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- 响应断言：验证被正确拦截（返回失败或空数据） -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="断言_穿透被布隆过滤器拦截" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">(success.*false|商铺不存在|null)</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">❌ 缓存穿透未被拦截！请求可能穿透到数据库，检查BloomFilter是否正常工作</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
            <stringProp name="Assertion.assume_success">false</stringProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- 响应时间断言：穿透拦截应该非常快（<50ms，布隆过滤器是内存操作） -->
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="断言_响应时间&lt;50ms_布隆过滤器应该很快" enabled="true">
            <stringProp name="DurationAssertion.duration">50</stringProp>
            <stringProp name="DurationAssertion.custom_message">⚠️ 穿透拦截响应过慢(&gt;50ms)，可能未走布隆过滤器，或者BloomFilter未初始化</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>

        <!-- 统计结果 -->
        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="统计报告-缓存穿透" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
