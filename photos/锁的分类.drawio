<mxfile host="app.diagrams.net" modified="2025-08-25T00:00:00.000Z" agent="trae" version="24.0.0">
  <diagram name="锁的分类" id="lock-classification">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="锁的分类（面试必考）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 第一层：四大维度 ==================== -->

        <!-- 维度1：是否锁住资源 -->
        <mxCell id="dim1" value="&lt;b&gt;是否锁住资源&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 维度2：锁的设计理念 -->
        <mxCell id="dim2" value="&lt;b&gt;锁的设计理念&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 维度3：同一线程能否重复获取 -->
        <mxCell id="dim3" value="&lt;b&gt;同一线程能否重复获取&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- 维度4：多线程能否共享 -->
        <mxCell id="dim4" value="&lt;b&gt;多线程能否共享&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16213e;strokeColor=#0f3460;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="1140" y="80" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 维度1：悲观锁 vs 乐观锁 ==================== -->

        <!-- 悲观锁 -->
        <mxCell id="pessimistic" value="&lt;b&gt;悲观锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#c23152;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pessimistic_sub1" value="认为冲突一定发生&lt;br&gt;先锁再操作" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#e94560;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="pessimistic_ex1" value="synchronized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="260" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pessimistic_ex2" value="ReentrantLock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="90" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pessimistic_ex3" value="行锁/表锁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="260" width="70" height="25" as="geometry" />
        </mxCell>

        <!-- 乐观锁 -->
        <mxCell id="optimistic" value="&lt;b&gt;乐观锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#0a2647;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="optimistic_sub1" value="认为冲突不一定发生&lt;br&gt;操作完再检查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#0f3460;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="optimistic_ex1" value="CAS（原子类）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="410" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="optimistic_ex2" value="版本号/时间戳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="410" width="100" height="25" as="geometry" />
        </mxCell>

        <!-- 悲观锁 vs 乐观锁 对比 -->
        <mxCell id="compare1" value="&lt;b&gt;对比&lt;/b&gt;：悲观锁适合&lt;font color=&quot;#e94560&quot;&gt;写多读少&lt;/font&gt;（互斥开销大）；&lt;br&gt;乐观锁适合&lt;font color=&quot;#0f3460&quot;&gt;读多写少&lt;/font&gt;（无锁读，CAS 自旋）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffc107;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 维度2：公平锁 vs 非公平锁 ==================== -->

        <!-- 公平锁 -->
        <mxCell id="fair" value="&lt;b&gt;公平锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#c23152;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fair_sub1" value="先到先得，按排队顺序&lt;br&gt;公平但吞吐量低" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#e94560;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="215" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="fair_ex" value="new ReentrantLock(true)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="140" height="25" as="geometry" />
        </mxCell>

        <!-- 非公平锁 -->
        <mxCell id="unfair" value="&lt;b&gt;非公平锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#0a2647;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="unfair_sub1" value="允许插队，吞吐量高&lt;br&gt;但可能线程饥饿" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#0f3460;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="365" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="unfair_ex1" value="new ReentrantLock()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="410" width="130" height="25" as="geometry" />
        </mxCell>
        <mxCell id="unfair_ex2" value="synchronized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="410" width="100" height="25" as="geometry" />
        </mxCell>

        <!-- 公平锁 vs 非公平锁 对比 -->
        <mxCell id="compare2" value="&lt;b&gt;对比&lt;/b&gt;：&lt;font color=&quot;#e94560&quot;&gt;公平锁&lt;/font&gt;不饥饿但慢；&lt;font color=&quot;#0f3460&quot;&gt;非公平锁&lt;/font&gt;快但可能饥饿（默认选择）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffc107;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 维度3：可重入锁 vs 不可重入锁 ==================== -->

        <mxCell id="reentrant" value="&lt;b&gt;可重入锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#0a2647;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="reentrant_sub1" value="同一线程可多次获取&lt;br&gt;内部维护计数器 state" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#0f3460;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="215" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="reentrant_ex1" value="ReentrantLock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="260" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="reentrant_ex2" value="synchronized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="260" width="90" height="25" as="geometry" />
        </mxCell>

        <mxCell id="non_reentrant" value="&lt;b&gt;不可重入锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#c23152;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="780" y="310" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="non_reentrant_sub1" value="同一线程重复获取会死锁&lt;br&gt;需自己实现 state 计数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#e94560;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="365" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="non_reentrant_ex1" value="项目中的 SimpleRedisLock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="410" width="160" height="25" as="geometry" />
        </mxCell>

        <!-- 可重入 vs 不可重入 对比 -->
        <mxCell id="compare3" value="&lt;b&gt;对比&lt;/b&gt;：&lt;font color=&quot;#0f3460&quot;&gt;可重入锁&lt;/font&gt;支持递归调用/嵌套锁；&lt;br&gt;&lt;font color=&quot;#e94560&quot;&gt;不可重入锁&lt;/font&gt;简单但易死锁（递归场景慎用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffc107;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 维度4：共享锁 vs 排他锁 ==================== -->

        <mxCell id="shared" value="&lt;b&gt;共享锁（读锁）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#0a2647;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="1140" y="160" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="shared_sub1" value="多线程可同时持有&lt;br&gt;读读不互斥，读写互斥" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#0f3460;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="215" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="shared_ex1" value="ReentrantReadWriteLock.ReadLock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1140" y="260" width="200" height="25" as="geometry" />
        </mxCell>

        <mxCell id="exclusive" value="&lt;b&gt;排他锁（写锁）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e94560;strokeColor=#c23152;fontColor=#ffffff;fontSize=13;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="1140" y="310" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="exclusive_sub1" value="只有一个线程能持有&lt;br&gt;写写互斥，写读互斥" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#e94560;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="365" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="exclusive_ex1" value="ReentrantReadWriteLock.WriteLock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1140" y="410" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- 共享 vs 排他 对比 -->
        <mxCell id="compare4" value="&lt;b&gt;对比&lt;/b&gt;：&lt;font color=&quot;#0f3460&quot;&gt;读锁&lt;/font&gt;允许多读并发；&lt;font color=&quot;#e94560&quot;&gt;写锁&lt;/font&gt;独占；&lt;br&gt;适合&lt;b&gt;读多写少&lt;/b&gt;场景（如缓存读写）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffc107;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="450" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== 分隔线 ==================== -->
        <mxCell id="divider" value="" style="line;strokeWidth=2;html=1;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="510" width="1340" height="10" as="geometry" />
        </mxCell>

        <!-- ==================== 进阶专题 ==================== -->
        <mxCell id="advanced_title" value="&lt;b&gt;进阶专题&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="550" y="520" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== synchronized 锁升级 ==================== -->
        <mxCell id="sync_title" value="&lt;b&gt;synchronized 锁升级过程&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#3a2366;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="280" height="35" as="geometry" />
        </mxCell>

        <mxCell id="sync1" value="&lt;b&gt;① 无锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="185" y="637" as="sourcePoint" />
            <mxPoint x="220" y="637" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sync2" value="&lt;b&gt;② 偏向锁&lt;/b&gt;&lt;br&gt;Mark Word 记录线程 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="225" y="615" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="370" y="637" as="sourcePoint" />
            <mxPoint x="410" y="637" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sync3" value="&lt;b&gt;③ 轻量级锁&lt;/b&gt;&lt;br&gt;CAS 自旋获取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="615" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" value="" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="560" y="637" as="sourcePoint" />
            <mxPoint x="600" y="637" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sync4" value="&lt;b&gt;④ 重量级锁&lt;/b&gt;&lt;br&gt;OS 互斥量，阻塞等待" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#757575;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="605" y="615" width="140" height="45" as="geometry" />
        </mxCell>

        <mxCell id="sync_note" value="&lt;b&gt;只能升级不能降级&lt;/b&gt;（偏向锁撤销除外）&lt;br&gt;目的：&lt;font color=&quot;#4caf50&quot;&gt;根据竞争程度逐步升级，平衡性能与安全&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#533483;fontColor=#333333;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="675" width="685" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== 分布式锁 ==================== -->
        <mxCell id="dist_title" value="&lt;b&gt;分布式锁&lt;/b&gt;（多 JVM 场景）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#3a2366;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="790" y="570" width="280" height="35" as="geometry" />
        </mxCell>

        <mxCell id="dist1" value="&lt;b&gt;Redis 分布式锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="620" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dist1_detail" value="SETNX + Lua 释放&lt;br&gt;Redisson（看门狗续期）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4caf50;fontColor=#333333;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="665" width="130" height="35" as="geometry" />
        </mxCell>

        <mxCell id="dist2" value="&lt;b&gt;ZooKeeper 锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="620" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dist2_detail" value="临时顺序节点&lt;br&gt;Watch 机制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ff9800;fontColor=#333333;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="665" width="130" height="35" as="geometry" />
        </mxCell>

        <mxCell id="dist3" value="&lt;b&gt;MySQL 锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;fontColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="620" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dist3_detail" value="唯一索引 / FOR UPDATE&lt;br&gt;性能差，不推荐" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#f44336;fontColor=#333333;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="665" width="130" height="35" as="geometry" />
        </mxCell>

        <!-- 分布式锁对比 -->
        <mxCell id="dist_compare" value="&lt;b&gt;选型对比&lt;/b&gt;：&lt;font color=&quot;#4caf50&quot;&gt;Redis&lt;/font&gt; AP 高性能（本项目）；&lt;font color=&quot;#ff9800&quot;&gt;ZK&lt;/font&gt; CP 强一致；&lt;font color=&quot;#f44336&quot;&gt;MySQL&lt;/font&gt; 性能差仅兜底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffc107;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="710" width="550" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== 自旋锁 ==================== -->
        <mxCell id="spin_title" value="&lt;b&gt;自旋锁 &amp; 适应性自旋锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#3a2366;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="280" height="35" as="geometry" />
        </mxCell>

        <mxCell id="spin1" value="&lt;b&gt;自旋锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="spin1_detail" value="线程不阻塞，循环等待&lt;br&gt;适用：锁持有时间极短" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#4caf50;fontColor=#333333;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="835" width="130" height="35" as="geometry" />
        </mxCell>

        <mxCell id="spin2" value="&lt;b&gt;适应性自旋锁&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="790" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="spin2_detail" value="自旋时间动态调整&lt;br&gt;上次成功→多等会儿" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#ff9800;fontColor=#333333;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="835" width="130" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== 分段锁 ==================== -->
        <mxCell id="segment_title" value="&lt;b&gt;分段锁（Segment Lock）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#3a2366;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="400" y="740" width="280" height="35" as="geometry" />
        </mxCell>

        <mxCell id="segment_detail" value="将数据分成多个段，每段独立加锁&lt;br&gt;典型：ConcurrentHashMap（JDK7）&lt;br&gt;JDK8 已改为 CAS + synchronized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#533483;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="790" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== 项目实战 ==================== -->
        <mxCell id="project_title" value="&lt;b&gt;本项目中的锁实战&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#0d0d1a;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="740" y="770" width="280" height="35" as="geometry" />
        </mxCell>

        <mxCell id="project1" value="&lt;b&gt;SimpleRedisLock&lt;/b&gt;&lt;br&gt;SETNX + Lua 原子释放&lt;br&gt;不可重入（项目中的坑）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#e94560;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="815" width="130" height="55" as="geometry" />
        </mxCell>

        <mxCell id="project2" value="&lt;b&gt;Redisson 分布式锁&lt;/b&gt;&lt;br&gt;可重入 + 看门狗续期&lt;br&gt;秒杀一人一单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#0f3460;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="885" y="815" width="135" height="55" as="geometry" />
        </mxCell>

        <!-- ==================== 底部总结 ==================== -->
        <mxCell id="summary" value="&lt;b&gt;面试口诀&lt;/b&gt;：悲观锁写多读少，乐观锁读多写少；&lt;br&gt;公平锁排队不饿，非公平锁快但饥饿；可重入锁递归安全，分布式锁跨 JVM 互斥；&lt;br&gt;synchronized 无锁→偏向→轻量→重量 逐步升级，自旋锁短持有不阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#0d0d1a;fontColor=#e0e0e0;fontSize=12;align=center;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1280" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
