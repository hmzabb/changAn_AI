# ============ 大模型（DeepSeek） ============
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============ Embedding（硅基流动，DeepSeek 不提供 embedding 接口） ============
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ LangSmith 监控（可选） ============
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT="chang_an_ai"

# ============ Java 后端（数据源） ============
JAVA_BASE_URL=http://127.0.0.1:8081
JAVA_TIMEOUT_SECONDS=3

# ============ RAG 参数 ============
RAG_RECALL_TOP_K=8
RAG_RERANK_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=6000

# ============ Milvus 向量库（Docker standalone，gRPC 19530 / HTTP 9091） ============
MILVUS_URI=http://127.0.0.1:19530

# ============ 服务 ============
APP_HOST=127.0.0.1
APP_PORT=8000